 "raw_output": "{\"chunk_id\": \"CMG__chunk_033\", \"candidates\": [\n  {\n    \"proposed_name\": \"menu_price\",\n    \"quote\": \"The increase is primarily attributable to an increase in menu prices and, to a lesser extent, an increase in transactions\",\n    \"evidence\": {\n      \"company\": \"CMG\",\n      \"source_type\": \"10-K\",\n      \"source_id\": \"0001058090-23-000010\",\n      \"date\": \"2023-02-08\"\n    },\n    \"per_x\": null,\n    \"slice_note\": null\n  },\n  {\n    \"proposed_name\": \"transactions\",\n    \"quote\": \"The increase is primarily attributable to an increase in menu prices and, to a lesser extent, an increase in transactions\",\n    \"evidence\": {\n      \"company\": \"CMG\",\n      \"source_type\": \"10-K\",\n      \"source_id\": \"0001058090-23-000010\",\n      \"date\": \"2023-02-08\"\n    },\n    \"per_x\": null,\n    \"slice_note\": null\n  },\n  {\n    \"proposed_name\": \"group_size\",\n    \"quote\": \"partially offset by a decrease in group size from the continued resurgence of our in-restaurant business\",\n    \"evidence\": {\n      \"company\": \"CMG\",\n      \"source_type\": \"10-K\",\n      \"source_id\": \"0001058090-23-000010\",\n      \"date\": \"2023-02-08\"\n    },\n    \"per_x\": null,\n    \"slice_note\": null\n  },\n  {\n    \"proposed_name\": \"consumer_behavior_shift\",\n    \"quote\": \"The increase was primarily due to menu price increases, a shift in consumer behaviors related to COVID-19 from digital sales to in-restaurant sales\",\n    \"evidence\": {\n      \"company\": \"CMG\",\n      \"source_type\": \"10-K\",\n      \"source_id\": \"0001058090-23-000010\",\n      \"date\": \"2023-02-08\"\n    },\n    \"per_x\": null,\n    \"slice_note\": null\n  },\n  {\n    \"proposed_name\": \"new_restaurant_openings\",\n    \"quote\": \"Total revenue increased due to comparable restaurant sales increase of $568.6 million and restaurants not yet in the comparable base of $519.4 million\",\n    \"evidence\": {\