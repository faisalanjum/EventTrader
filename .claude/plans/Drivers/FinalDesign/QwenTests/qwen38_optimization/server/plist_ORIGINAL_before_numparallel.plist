<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.faanjum.ollama</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/ollama</string>
    <string>serve</string>
  </array>

  <!-- Network-reachable so the Minisforum can call it; model never unloads. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key><string>0.0.0.0:11434</string>
    <key>OLLAMA_KEEP_ALIVE</key><string>-1</string>
    <key>OLLAMA_FLASH_ATTENTION</key><string>1</string>
    <key>OLLAMA_MAX_LOADED_MODELS</key><string>1</string>
    <!-- Bulk extraction workload: concurrent slots so client-side
         ThreadPoolExecutor(--workers N) actually parallelises. Each slot
         costs one num_ctx KV cache (~1.9 GiB @32K). -->
    <key>OLLAMA_NUM_PARALLEL</key><string>4</string>
    <!-- Quantized KV cache: large memory saving at long context. -->
    <key>OLLAMA_KV_CACHE_TYPE</key><string>q8_0</string>
  </dict>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>

  <key>StandardOutPath</key><string>/tmp/ollama-agent.log</string>
  <key>StandardErrorPath</key><string>/tmp/ollama-agent.err</string>
</dict>
</plist>
