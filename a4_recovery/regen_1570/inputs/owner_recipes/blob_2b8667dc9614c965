    """Every ORDERED launcher identity, armed and unarmed, from this run."""
    rows = []
    for inv in json.load(io.open(os.path.join(run_dir, "receipt.json"),
                                 encoding="utf-8"))["invocations"]:
        armed = inv["scriptPath"]
        name = os.path.basename(armed)
