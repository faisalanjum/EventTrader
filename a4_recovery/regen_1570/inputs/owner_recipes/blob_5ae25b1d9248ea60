class _Bound(object):
    """The real Bound with named fields redirected at copies."""

    def __init__(self, real, **over):
        for name in dir(real):
            if not name.startswith("_"):
                setattr(self, name, getattr(real, name))
        for name, value in over.items():
            setattr(self, name, value)


@pytest.fixture
def staged(tmp_path, monkeypatch):
    """The two counted runs, copied; everything else still the real thing."""
    real = A6.bound()
    v6 = str(tmp_path / "v6")
    signer = str(tmp_path / "signer")
    shutil.copytree(real.decision_correction_v6, v6)
    shutil.copytree(A6._read_ptr("signer_dir.txt"), signer)
    monkeypatch.setattr(A6, "bound",
                        lambda: _Bound(real, decision_correction_v6=v6))
    real_read = A6._read_ptr                 # every OTHER pointer stays real
    monkeypatch.setattr(A6, "_read_ptr",
                        lambda name: signer if name == "signer_dir.txt"
                        else real_read(name))
    return {"v6": v6, "signer": signer}


